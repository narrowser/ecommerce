generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Notification {
  id        String   @id @default(uuid())
  userId    String
  type      String
  title     String
  content   String
  isRead    Boolean  @default(false)
  createdAt DateTime @default(now())
}

model EmailLog {
  id      String   @id @default(uuid())
  to      String
  subject String
  body    String   @db.Text
  status  String   @default("PENDING")
  sentAt  DateTime?
}
